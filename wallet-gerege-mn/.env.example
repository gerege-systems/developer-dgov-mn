# wallet.gerege.mn — БИЕ ДААСАН орчны жишээ. `.env` болгож хуулна (commit БИШ).
# Бусад систем client_id/secret-ээр холбогдоно (gerege auth-аас хамаарахгүй).

# --- HTTP ---
PORT=8080
API_PORT=8092
ENVIRONMENT=development   # bundled дотоод PG. Гадаад/managed DB бол: production + sslmode=verify-full
DEBUG=false

# --- Bundled Postgres (docker-compose) ---
POSTGRES_USER=wallet
POSTGRES_PASSWORD=CHANGEME_strong_pg_password
POSTGRES_DB=gerege_platform

# --- DB DSN-ууд ---
# API нь withSubject дотор `SET LOCAL ROLE app_user` хийдэг тул superuser
# холболтоор ч RLS хүчинтэй (production-д dedicated app_user ашиглаж болно).
# Worker/migrate/client нь superuser DSN-ээр SECURITY DEFINER функц дуудна.
DB_APP_URL=postgres://wallet:CHANGEME_strong_pg_password@postgres:5432/gerege_platform?sslmode=disable&search_path=gerege_platform,public
DB_POSTGRE_URL=postgres://wallet:CHANGEME_strong_pg_password@postgres:5432/gerege_platform?sslmode=disable&search_path=gerege_platform,public
DB_MAX_OPEN_CONNS=15
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFE_MINS=15

# --- JWT (wallet-ийн ӨӨРИЙН signing secret; client_credentials токен гаргана) ---
JWT_SECRET=CHANGEME_wallet_own_signing_secret_min_32_chars
JWT_ISSUER=wallet.gerege.mn
JWT_EXPIRED=1            # access токен (цаг). client дахин /oauth/token дуудна.
JWT_REFRESH_EXPIRED=7
BCRYPT_COST=12          # client_secret hash

# --- auth.gerege.mn хэрэглэгчээр нэвтрэх (СОНГОЛТООР) ---
# Иргэн me.gerege.mn-ээр нэвтэрч wallet-д хандвал тэдний токеныг (issuer
# auth.gerege.mn) ХҮЛЭЭН АВНА. auth-тай хуваалцсан HS256 secret. Хоосон бол
# зөвхөн client_credentials токен.
AUTH_JWT_SECRET=
AUTH_JWT_ISSUER=auth.gerege.mn

# --- Wallet IBAN ---
WALLET_IBAN_COUNTRY=MN
WALLET_IBAN_BANK_CODE=

# --- Банкны gateway top-up webhook HMAC (хоосон бол идэвхгүй) ---
WALLET_GATEWAY_HMAC_SECRET=

# --- Worker alerting (хоосон бол зөвхөн лог) ---
ALERT_WEBHOOK_URL=

# --- Observability (сонголтоор) ---
OTEL_EXPORTER=
OTEL_SAMPLE_RATIO=

# --- Redis (СОНГОЛТООР — token revocation; бие даасан хувилбарт ихэвчлэн хэрэггүй) ---
REDIS_HOST=
REDIS_PASS=
